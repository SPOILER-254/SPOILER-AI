# Core AI & Hosting
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://your-domain.onrender.com"
PORT=3000

# Persistent Storage (mount disk on Render /var/data or Railway /data)
DATA_DIR="./data"
# Optional explicit SQLite DB path override:
# SQLITE_DB_PATH="/var/data/spoiler.db"

# Security & Encryption (32+ char secrets required in production)
SESSION_SECRET=""
TOKEN_ENCRYPTION_KEY=""
ADMIN_PASSCODE=""

# Transactional Email (Resend HTTPS API - optional for live verification/reset emails)
RESEND_API_KEY=""
EMAIL_FROM="SPOILER AI <no-reply@yourdomain.com>"

# WhatsApp Business Cloud API & Meta Platforms (Instagram / Facebook / Messenger / Threads)
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="spoiler_ai_verify_token"

# Third-Party OAuth Credentials (Optional per platform; can also be managed in Admin -> API Credentials)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_GOOGLE_CLIENT_ID=""
YOUTUBE_GOOGLE_CLIENT_SECRET=""

# Payments (M-Pesa Daraja Kenya & Stripe)
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
